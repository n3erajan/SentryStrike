# SentryStrike backend environment template
# Shared database, Redis, queue, lifecycle, and public-host values live in ../.env.

# App
APP_NAME=Sentry Strike Backend
APP_DEBUG=true
CORS_ORIGINS=["*"]

# Backend authentication
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_NAME=sentrystrike_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Workspace invitations
INVITE_TTL_HOURS=168
INVITE_WORKSPACE_LIMIT_PER_HOUR=20
INVITE_ACTOR_LIMIT_PER_TEN_MINUTES=5
INVITE_RATE_LIMIT_KEY_PREFIX=sentrystrike:invite-rate

# Public access requests and Cloudflare Turnstile
# These are Cloudflare's always-pass test keys for local development. Replace
# both with keys from a Turnstile widget before setting APP_DEBUG=false.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ACCESS_REQUEST_TTL_DAYS=30
ACCESS_REQUEST_IP_LIMIT_PER_FIFTEEN_MINUTES=1
ACCESS_REQUEST_IP_LIMIT_PER_DAY=7
ACCESS_REQUEST_RATE_LIMIT_KEY_PREFIX=sentrystrike:access-request-rate

# SMTP email delivery
# Local defaults target a development SMTP server. Configure a real relay in
# deployment; Gmail requires 2-Step Verification plus an app password.
EMAIL_FROM=SentryStrike <no-reply@sentrystrike.local>
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=false

# Scan-data retention worker
RETENTION_PURGE_INTERVAL_SECONDS=43200

# Backend logging is console-only.
LOG_LEVEL=INFO
