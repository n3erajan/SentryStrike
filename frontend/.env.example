# Base URL of the SentryStrike backend API. Vite bakes this into the bundle at
# build time. Copy this file to `.env` and adjust if your backend lives elsewhere.
#
# Dev: the frontend (http://localhost:5173) and backend are different origins, so
# requests are cross-origin — the backend's CORS must allow the frontend origin
# with credentials (the auth session cookie).
#
# Same-origin production behind a reverse proxy: use a relative value, e.g. /api/v1
VITE_API_URL=http://localhost:8000/api/v1
