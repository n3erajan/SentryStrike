# SentryStrike scanner worker environment template
# Shared database, Redis, queue, lifecycle, and public-host values live in ../.env.

# Analysis handoff repair cadence
ANALYSIS_RECONCILE_INTERVAL_SECONDS=30

# Crawler / scanner
CRAWL_DEPTH=3
CRAWL_MAX_URLS=200
CRAWL_RATE_LIMIT_PER_SECOND=8.0
CRAWL_BROWSER_MODE=auto
CRAWL_BROWSER_MAX_INTERACTIONS=25
CRAWL_BROWSER_BUDGET_SECONDS=300.0
CRAWL_BROWSER_PER_ROUTE_SECONDS=6.0
CRAWL_BROWSER_ROUTE_CAP_SECONDS=60.0
CRAWL_BROWSER_BASE_SECONDS=30.0
CRAWL_BROWSER_ROUTE_CAP=120
CRAWL_BROWSER_WORKERS=4
CRAWL_BROWSER_ACTION_TIMEOUT_MS=2000.0
CRAWL_BROWSER_ACTION_CLICK_LIMIT=15
CRAWL_BROWSER_ACTION_CLICK_PASSES=2
CRAWL_BROWSER_WORKFLOW_DEPTH=2
CRAWL_BROWSER_BLOCK_RESOURCES=true
XSS_BROWSER_DOM_MAX_JOBS=12
XSS_BROWSER_DOM_BUDGET_SECONDS=60.0
OPEN_REDIRECT_BROWSER_MAX_JOBS=10
OPEN_REDIRECT_BROWSER_BUDGET_SECONDS=45.0
REQUEST_TIMEOUT_SECONDS=10.0
SCANNER_CONCURRENCY=8
SENSITIVE_PATHS_PERMUTATION_CAP=200
SCANNER_PER_DETECTOR_REQUEST_CAP=6000
SCANNER_PER_PARAMETER_REQUEST_CAP=600
SCAN_MODE=verified
BLIND_INJECTION_TIMING_THRESHOLD=0.7

# Authenticated scanning credentials are supplied per scan, never by environment.
ALLOW_SECONDARY_PROVISIONING=false
# Optional authentication discovery hints; credentials still come from each scan.
# SCAN_AUTH_LOGIN_URL=
# SCAN_AUTH_SUCCESS_URL=
# SCAN_AUTH_SUCCESS_TEXT=
# SCAN_AUTH_SUCCESS_REGEX=
# SCAN_AUTH_FAILURE_TEXT=
# SCAN_AUTH_FAILURE_REGEX=
# SCAN_AUTH_VALIDATION_URL=

# Access-control safety controls
ACCESS_CONTROL_PROBE_MUTATING_METHODS=true
ALLOW_DESTRUCTIVE_AUTHZ_CONFIRMATION=false

# OAST callback/poll URLs normally derive from PUBLIC_HOSTNAME in ../.env.
# Set these for direct worker execution only when callback and poll routes differ.
# Docker Compose overrides belong in the root .env because Compose interpolation
# happens before service env_file values are loaded.
# OAST_CALLBACK_BASE_URL=http://host.docker.internal:8000/oast
# OAST_POLL_URL=http://localhost:8000/oast/poll
SSRF_OAST_POLL_ATTEMPTS=5
SSRF_OAST_POLL_INTERVAL_SECONDS=0.4
SSRF_INBAND_TIMING_DELTA_MS=1500.0

# Vulnerability intelligence
#
# Components are matched to CVEs by product identity and version range, never by
# description keyword. Each source covers a different part of a stack; see
# "Vulnerability intelligence" in scanner/README.md.
#
# NVD - servers, languages and CMS cores, matched by CPE. Set the key: unkeyed,
# NVD allows only 5 requests per rolling 30 seconds and answers 403/429 beyond
# that, so a stack with more than a handful of versioned components will have
# lookups fail. A key raises the limit to 50/30s and is issued instantly at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
CVE_CACHE_TTL_SECONDS=3600

# Wordfence Intelligence v3 - WordPress plugins and themes, which NVD covers late
# and incompletely. Optional; without a key those components are reported as
# "not assessed" rather than assumed clean. Free key via a Wordfence.com account:
# https://www.wordfence.com/help/wordfence-intelligence
# (v1/v2 of this feed were switched off on 2026-03-09 and now answer HTTP 410.)
WORDFENCE_API_URL=https://www.wordfence.com/api/intelligence/v3/vulnerabilities/production
WORDFENCE_API_KEY=

# OSV.dev (npm / PyPI / Packagist / RubyGems advisories) and the CISA KEV + EPSS
# ranking overlays need no credentials. Override only for an air-gapped mirror.
OSV_API_URL=https://api.osv.dev/v1/query
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
THREAT_INTEL_CACHE_TTL_SECONDS=21600

# Scanner logging
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
